{
  "name": "cookie-roguelike",
  "version": "0.1.0",
  "private": true,
  "description": "A turn-based slingshot adventure built with React.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:leaderboard": "swa start http://127.0.0.1:5173 --api-location api",
    "build": "vite build",
    "build:azure": "npm run build && node scripts/write-swa-config.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs tests/api/*.test.cjs",
    "test:e2e": "playwright test",
    "test:studio": "playwright test --config playwright.studio.config.cjs",
    "preview:e2e": "npm run build && vite preview --host 127.0.0.1 --port 4180 --strictPort"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
